# Python / tooling
**/__pycache__/
**/wandb/
OmniVLA.egg-info/
.DS_Store
*.bak
*.bak-*

# Upstream OmniVLA checkpoints and assets (downloaded, not redistributed)
omnivla-finetuned-cast/
omnivla-original/
omnivla-original-balance/
omnivla-edge/
MBRA/
MBRA_BDD/
/paper/

# Run artifacts (data, training, evaluation)
runs/*
checkpoints/

# Isaac Sim environments, goal images and scratch outputs
isaac_sim/assets/
isaac_sim/scouting/goal_graphs/
isaac_sim/goal_images/
isaac_sim/tmp/
isaac_sim/eval_launch_logs/
isaac_sim/datagen_launch_logs/
isaac_sim/outputs/
isaac_sim/multirun/

# Throwaway exploration and vendored external code
scratch/
third_party/

# Real-robot data and live-run captures (rosbags, recordings, per-step artifacts).
# Code inside real_world/live/artifacts/ is re-included by extension; ignore the
# contents, not the dir itself, so git descends far enough for the negations.
real_world/data/
real_world/live/artifacts/**
!real_world/live/artifacts/
!real_world/live/artifacts/*.py
!real_world/live/artifacts/*.sh
!real_world/live/artifacts/*.json
!real_world/live/artifacts/*.json5
real_world/live/artifacts/_*
real_world/live/artifacts/audit_map.json
real_world/live/artifacts_fork/step_*/
# Mount-shim copies of the loop: the canonical files live in real_world/live/.
real_world/live/artifacts/operator_loop.py
real_world/live/artifacts/stitch_live.py

# Generated real-robot outputs and visualisations
real_world/outputs/
real_world/out_*/
viz_data/
viz_runs/
viz_out_*/
xcheck_*.npz
